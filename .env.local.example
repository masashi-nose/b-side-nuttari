# Sanity（sanity.io/manage のプロジェクト設定で確認できる）
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# サイトが Sanity を読むための Viewer（読み取り専用）トークン。
# データセットが非公開なので、サーバー側から認証して読む。
# NEXT_PUBLIC_ を付けないこと（ブラウザには渡らない）。
# 作り方: npx sanity tokens create "web-read" --role viewer
SANITY_API_READ_TOKEN=

# 一括登録スクリプト（npm run seed:spots）だけで使う書き込みトークン。
# ローカル専用。Vercel には登録しない。
# 作り方: npx sanity tokens create "seed-spots" --role editor
SANITY_API_WRITE_TOKEN=
